{
  "name": "wled-ui",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "dev:home": "vite --mode home",
    "dev:mock": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/mock-wled.mjs",
    "build": "tsc --noEmit && vite build",
    "build:home": "tsc --noEmit && vite build --mode home",
    "build:lamp": "tsc --noEmit && vite build --mode lamp",
    "preview": "vite preview",
    "serve": "vite build && vite preview --port 4173 --strictPort",
    "serve:home": "vite build --mode home && vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "node scripts/probe.mjs",
    "upload:lamp": "node scripts/upload-to-lamp.mjs"
  },
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12",
    "ws": "^8.22.1"
  },
  "private": true
}
