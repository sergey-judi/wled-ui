# Default mode: you are connected to the lamp's own Wi-Fi ("[LF.UA] sound").
# Used by: npm run dev, npm run serve, npm run build
VITE_WLED_HOST=4.3.2.1

# Which network interface the LOCAL servers listen on (npm run dev / serve / dev:mock). Not part of the app bundle.
#   127.0.0.1      only this computer (default, nothing exposed to the network)
#   192.168.1.105  only that one interface of this computer (e.g. home Wi-Fi), so phones on that network can open it
#   0.0.0.0        every interface (all networks this computer is on)
# Override per machine in .env.local, or per run: DEV_SERVER_HOST=0.0.0.0 npm run serve
DEV_SERVER_HOST=127.0.0.1
